{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drenyra.dev/contracts/receipt-schema/v1/schemas/signing-key-info.schema.json",
  "title": "SigningKeyInfo",
  "description": "Trusted signing key metadata used by the trusted verification surface (spec §2.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["keyId", "publicKey", "issuedAt"],
  "properties": {
    "keyId": { "type": "string", "minLength": 1 },
    "publicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "base64 DER SPKI (Ed25519 OID 1.3.101.112); decoded length is enforced by harnesses"
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revokedAt": { "type": "string", "format": "date-time" }
  }
}

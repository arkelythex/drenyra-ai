{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drenyra brand-system tokens",
  "description": "Canonical token vectors for contracts/brand-system.md (v0.2 DRAFT). Mirrors the Drenyra apps/web DTCG token pipeline exactly: class-based .dark/.light themes with cyan/violet accents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "source",
    "themes",
    "accents",
    "gradients",
    "typography",
    "radius",
    "aiImage"
  ],
  "properties": {
    "version": { "type": "string", "const": "0.2" },
    "status": { "type": "string", "const": "DRAFT" },
    "source": { "type": "string" },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dark", "light"],
      "properties": {
        "dark": { "$ref": "#/definitions/theme" },
        "light": { "$ref": "#/definitions/theme" }
      }
    },
    "accents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cyan", "violet"],
      "properties": {
        "cyan": { "$ref": "#/definitions/accent" },
        "violet": { "$ref": "#/definitions/accent" }
      }
    },
    "gradients": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+$" },
        "minItems": 2
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": ["display", "sans", "mono"]
    },
    "radius": { "type": "string" },
    "aiImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tolerancePerChannel", "coverageRequired", "criticalText", "provenance", "formats"],
      "properties": {
        "tolerancePerChannel": { "type": "integer", "minimum": 0, "maximum": 255 },
        "coverageRequired": { "type": "number", "minimum": 0, "maximum": 1 },
        "criticalText": { "type": "string", "const": "none" },
        "provenance": { "type": "string", "const": "c2pa-required" },
        "formats": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "hexColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "theme": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/hexColor" }
    },
    "accent": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/hexColor" }
    }
  }
}

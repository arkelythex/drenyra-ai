{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-config-schema.json",
  "config": {
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": [
    "**/*.md",
    "!node_modules/**",
    "!dist/**",
    "!.atl/**",
    "!.pi/**",
    "!logs/**"
  ]
}

  "cards": [
    {
      "dot": "cyan",
      "title": "The path is fixed",
      "items": [
        "A command enters through thin adapters (cmd/, mcp/, or the library)",
        "agents/ stages a plan; missions/ — the durable runtime — decides what happens next"
      ]
    },
    {
      "dot": "rose",
      "title": "Authority is derived, never asserted",
      "items": [
        "Materiality R0–R3 sets the review depth; gates/ fails closed with needs_input",
        "A professional approves explicitly at R2 (single) and R3 (two distinct approvers)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nothing material happens without a receipt",
      "items": [
        "Every material action produces an Ed25519-signed receipt",
        "The append-only ledger chains receipts so order survives any single tampering attempt"
      ]
    }
  ]

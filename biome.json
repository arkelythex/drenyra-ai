{
  "$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
  "files": {
    "includes": [
      "receipts/**/*.ts",
      "ledger/**/*.ts",
      "missions/**/*.ts",
      "candidates/**/*.ts",
      "review/**/*.ts",
      "gates/**/*.ts",
      "recovery/**/*.ts",
      "tenant-core/**/*.ts",
      "tenant-isolation/**/*.ts",
      "agents/**/*.ts",
      "cmd/**/*.ts",
      "contracts/__tests__/**/*.ts",
      "evidence/**/*.ts",
      "skills/**/*.ts",
      "security/**/*.ts",
      "guardian/**/*.ts",
      "adapters/**/*.ts",
      "flow/**/*.ts",
      "vitest.config.ts",
      "scripts/*.mjs"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noDuplicateObjectKeys": "error"
      }
    }
  }
}

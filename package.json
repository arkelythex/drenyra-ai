{
  "name": "drenyra-ai",
  "version": "0.2.0",
  "description": "Standalone RDA (Receipt-Driven Accounting) core \u2014 receipt verification against frozen conformance vectors, append-only audit ledger validation, mission protocol + runtime, candidate identity/materiality, and proportional review lenses. Library modules use node:crypto only; the CLI adds ajv for schema validation.",
  "type": "module",
  "bin": {
    "drenyra-ai": "./dist/cmd/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "contracts",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./receipts": "./dist/receipts/index.js",
    "./ledger": "./dist/ledger/index.js",
    "./missions": "./dist/missions/index.js",
    "./candidates": "./dist/candidates/index.js",
    "./evidence": "./dist/evidence/index.js",
    "./review": "./dist/review/index.js",
    "./gates": "./dist/gates/index.js",
    "./recovery": "./dist/recovery/index.js",
    "./tenant": "./dist/tenant-core/index.js",
    "./skills": "./dist/skills/index.js",
    "./security": "./dist/security/index.js",
    "./guardian": "./dist/guardian/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./adapters": "./dist/adapters/index.js",
    "./flow": "./dist/flow/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/build.mjs",
    "verify:package": "node scripts/build.mjs && bun run test && node scripts/verify-package-files.mjs",
    "prepack": "bun run verify:package",
    "prepublishOnly": "bun run typecheck && bun run verify:package && node scripts/verify-packed-install.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "receipts",
    "ledger",
    "missions",
    "candidates",
    "review",
    "gates",
    "recovery",
    "tenant-core",
    "tenant-isolation",
    "agents",
    "cmd",
    "index.ts",
    "evidence",
    "skills",
    "security",
    "guardian",
    "mcp",
    "adapters",
    "flow"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/__tests__/**",
    "vitest.config.ts"
  ]
}
